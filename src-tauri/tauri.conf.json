{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Icebox",
  "version": "0.3.0",
  "identifier": "uk.co.blockchainology.icebox",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Icebox \u2014 Frostsnap wallet",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "deb",
      "rpm",
      "appimage",
      "app",
      "dmg"
    ],
    "category": "Finance",
    "shortDescription": "Desktop wallet for Frostsnap devices",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-frostsnap.rules": "../linux/70-frostsnap.rules"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-frostsnap.rules": "../linux/70-frostsnap.rules"
        }
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
